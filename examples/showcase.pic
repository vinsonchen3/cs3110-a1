canvas 800 600 navy

transform translate 600 150

  repeat 12 rotate 30
    transform translate 0 -100
      rectangle 0 0 10 60 orange
    end
  end

  circle 0 0 70 yellow
end

transform translate 80 250
  repeat 4 translate 170 0
    rectangle 0 0 140 300 blue

    repeat 3 translate 0 90
      rectangle 20 20 100 60 green
    end
  end
end

line 0 550 800 550 white 8

text 400 80 36 white CITY SUNSET
